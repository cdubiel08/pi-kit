{
  "name": "@cdubiel08/pi-kit",
  "version": "0.1.0",
  "description": "A focused UI and TUI kit for the Pi coding agent",
  "displayName": "Tokyo Night Clear",
  "publisher": "cdubiel08",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "tui",
    "theme"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cdubiel08/pi-kit.git"
  },
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "extensions/",
    "themes/",
    "palettes/",
    "adapters/",
    "scripts/generate-themes.mjs",
    "scripts/validate-themes.mjs",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "tokyo-holo.config.example.json"
  ],
  "scripts": {
    "test": "node --test extensions/tokyo-holo/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "generate:themes": "node scripts/generate-themes.mjs",
    "check:generated": "node scripts/generate-themes.mjs --check",
    "validate:themes": "node scripts/validate-themes.mjs",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm test && npm run check:generated && npm run validate:themes && npm run audit:runtime"
  },
  "contributes": {
    "themes": [
      {
        "label": "Tokyo Night Clear",
        "uiTheme": "vs-dark",
        "path": "./themes/vscode/tokyo-night-clear-color-theme.json"
      }
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/tokyo-holo/index.ts"
    ],
    "themes": [
      "./themes/*.json"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
