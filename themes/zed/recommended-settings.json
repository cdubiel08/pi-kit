{
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "agent": {
    "dock": "left"
  },
  "ui_font_family": "IBM Plex Sans",
  "ui_font_size": 16,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 15,
  "buffer_line_height": {
    "custom": 1.7
  },
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Tokyo Night Clear High Contrast"
  },
  "languages": {
    "Markdown": {
      "soft_wrap": "editor_width",
      "show_wrap_guides": false,
      "tab_size": 2,
      "format_on_save": "off",
      "buffer_font_family": "IBM Plex Sans",
      "buffer_font_size": 16,
      "buffer_line_height": {
        "custom": 1.8
      }
    }
  }
}
